# Crée une clé dans https://platform.openai.com/api-keys
# Ne mets jamais cette clé dans NEXT_PUBLIC_… ni dans Git.
OPENAI_API_KEY=
# Facultatif. Le modèle choisi par défaut est gpt-5-mini.
OPENAI_MODEL=gpt-5-mini
# Active la recherche d’établissements réels avec Places API (New).
GOOGLE_PLACES_API_KEY=
